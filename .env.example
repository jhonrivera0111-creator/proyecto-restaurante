# Variables para docker compose. Copiar a .env antes de "docker compose up".
# El archivo .env esta en .gitignore y no se sube al repositorio.

# Contrasena del usuario ADMIN que se crea en el primer arranque.
APP_ADMIN_PASSWORD=admin123

# Secreto para firmar los tokens de sesion. Cambiar en una instalacion real.
APP_SECURITY_TOKEN_SECRET=casaverde-docker-secret-cambiar
